# Solo servidor: el navegador nunca ve esta URL ni el token (la API se consume mediante el BFF).
# Origen del backend, sin ruta. El BFF añade /api/v1.
BACKEND_URL=http://127.0.0.1:3000

# Nombre de la cookie de sesión httpOnly.
SESSION_COOKIE=erp_session

# Origen público de esta aplicación, usado para validar el origen de las escrituras (CSRF).
APP_ORIGIN=http://localhost:5173
